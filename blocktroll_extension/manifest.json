{
  "manifest_version": 3,
  "name": "BlockTroll",
  "version": "0.3.0",
  "description": "AI agent comment filter for social platforms (TOXIC/SPAM/TAUNT).",

  "permissions": ["storage"],
  "host_permissions": [
    "http://127.0.0.1:8787/*",
    "http://localhost:8787/*"
  ],

  "options_page": "options.html",

  "content_scripts": [
    {
      "matches": [
        "https://youtube.com/*",
        "https://*.youtube.com/*",
        "https://instagram.com/*",
        "https://*.instagram.com/*",
        "https://x.com/*",
        "https://*.x.com/*",
        "https://twitter.com/*",
        "https://*.twitter.com/*",
        "https://threads.net/*",
        "https://*.threads.net/*",
        "https://facebook.com/*",
        "https://*.facebook.com/*",
        "https://tiktok.com/*",
        "https://*.tiktok.com/*"
      ],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  
    "action": {
      "default_popup": "popup.html",
      "default_title": "BlockTroll"
  }

  
}
